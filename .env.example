# TypeSafe JEV API açarı — https://console.typesafe.ai/settings/keys
JEV_API_KEY=

# OpenRouter açarı — LLM müqayisəsi üçün (istəyə bağlı)
# Olmasa layihə işləyir, sadəcə müqayisə deaktiv olur
OPENROUTER_API_KEY=

# Müqayisə üçün istifadə olunan model (standart: google/gemini-3.5-flash-lite)
# LLM_MODEL=google/gemini-3.5-flash-lite

# PORT=3100
